# Register a generated inspection plan in the local catalog.
# Called by the plan producer after every pipeline stage that writes a plan
# file, so each one becomes a selectable entry in the picker. The catalog never
# opens the file: everything it stores about the plan is stated here.
string backend
string part_id
string plan_path          # the plan file just written
string stage              # producer-defined stage label (required), e.g. ordered
int32 stage_rank          # producer-defined order; higher = further through the pipeline
string summary_json       # producer summary, stored verbatim
string summary_text       # one line shown in the picker
string change_token       # change token the plan was generated against ('' = the part's current)
string generated_at       # ISO-8601 UTC ('' = now)
bool force_upload         # upload regardless of the auto-upload stage policy
---
bool success
string plan_id
string stage              # the stage actually recorded
string upload_status      # local | uploading | synced | failed
string message
